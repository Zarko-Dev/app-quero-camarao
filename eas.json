{
    "cli": {
        "version": ">= 9.0.10",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "channel": "development",
            "distribution": "internal",
            "node": "20.19.4",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            },
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "buildConfiguration": "Debug"
            }
        },
        "production": {
            "channel": "production",
            "autoIncrement": true,
            "node": "20.19.4",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            },
            "ios": {
                "image": "macos-tahoe-26.4-xcode-26.4"
            }
        },
        "production-apk": {
            "extends": "production",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "production",
                "releaseStatus": "inProgress",
                "rollout": 0.05
            },
            "ios": {
                "appleId": "logicphire@logicphire.com.br",
                "ascAppId": "6467179239"
            }
        }
    }
}
