{
  "expo": {
    "name": "Quero Camarao",
    "slug": "mobile-quero-camarao",
    "owner": "querocamarao",
    "scheme": "querocamarao",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE2CC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "62",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permitir que a Quero Camarão use seu Face ID para acessar o aplicativo.",
        "NSCameraUsageDescription": "Permitir que a Quero Camarão acesse sua camera? Esta ação permite que seja tirado fotos que serão utilizadas no aplicativo, como fotos dos produtos.",
        "NSUserTrackingUsageDescription": "Para proporcionar uma experiência personalizada e segura, coletamos informações, como seu endereço de e-mail e informações de pagamento. Esses dados são usados exclusivamente para fins de autenticação, pagamento e comunicação.",
        "NSPhotoLibraryUsageDescription": "Permitir que a Quero Camarão acesse sua biblioteca de fotos para selecionar imagens utilizadas no aplicativo.",
        "NSDocumentsFolderUsageDescription": "Permitir que a Quero Camarão salve arquivos no dispositivo.",
        "NSDownloadsFolderUsageDescription": "Permitir que a Quero Camarão salve arquivos no dispositivo.",
        "LSApplicationQueriesSchemes": ["waze"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.logicphire.querocamarao",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:querocamarao.com.br"
      ]
    },
    "android": {
      "versionCode": 52,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFE2CC"
      },
      "package": "com.logicphire.querocamarao",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "querocamarao.com.br",
              "pathPrefix": "/publicacao"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "./plugins/withCppStandard.js",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE2CC",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#FFE2CC"
          },
          "imageWidth": 200
        }
      ],
      [
        "./plugins/withDisableForcedDarkModeAndroid.js",
        {}
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que a Quero Camarão acesse sua camera? Esta ação permite que seja tirado fotos que serão utilizadas no aplicativo, como fotos dos produtos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que a Quero Camarão use sua localização para enviá-la no chat, como a localização da fazenda."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que a Quero Camarão acesse sua biblioteca de fotos para enviar imagens no chat.",
          "cameraPermission": "Permitir que a Quero Camarão acesse sua câmera para tirar fotos no chat."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Para proporcionar uma experiência personalizada e segura, coletamos informações, como seu endereço de e-mail e informações de pagamento. Esses dados são usados exclusivamente para fins de autenticação, pagamento e comunicação. "
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificationicon.png",
          "color": "#F05829"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "logicphire-logic",
          "project": "mobile-quero-camarao"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "useFrameworks": "dynamic",
            "googleServicesFile": "./GoogleService-Info.plist",
            "extraBuildSettings": {
              "CLANG_CXX_LANGUAGE_STANDARD": "c++20"
            }
          }
        }
      ],
      [
        "./plugins/withAndroidNdk27.js",
        {}
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset",
      "@sentry/react-native",
      ["react-native-share", {}],
      "@react-native-firebase/app"
    ],
    "extra": {
      "eas": {
        "projectId": "9b561f08-e352-4697-940d-bca41e1c5cc6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9b561f08-e352-4697-940d-bca41e1c5cc6"
    }
  }
}
