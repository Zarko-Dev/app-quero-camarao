{
    "name": "mobile-quero-camarao",
    "version": "2.0.4",
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "test": "node --test tests/**/*.test.cjs",
        "test:unit": "node --test tests/**/*.test.cjs",
        "start:expo": "npx expo start --tunnel",
        "start:android": "yarn android && npx react-native start",
        "start:webserver": "npx serve web-build",
        "android": "npx react-native run-android",
        "configure:all": "npx expo prebuild && yarn prettier --write package.json",
        "configure:android": "npx expo prebuild --platform android && yarn prettier --write package.json",
        "configure:ios": "npx expo prebuild --platform ios && yarn prettier --write package.json",
        "doctor": "npx expo-doctor@latest",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "prepareversion": "./verifyPackageVersion.sh && yarn configure:android",
        "build:apk": "./replaceStatusProject.sh && yarn prepareversion && eas build --profile development",
        "build:apk-local": "./replaceStatusProject.sh && yarn prepareversion && eas build --profile development --local",
        "build:production": "./replaceStatusProject.sh && yarn prepareversion && eas build --profile production --auto-submit",
        "build:testflight": "./replaceStatusProject.sh && yarn prepareversion && eas build --profile production --auto-submit && eas submit --profile production",
        "postbuild:production": "./replaceBackStatusProject.sh",
        "deploy": "eas submit",
        "build:web": "npx expo export:web",
        "update:development": "./replaceStatusProject.sh && yarn prepareversion && eas update -p android --branch development --message ",
        "update:production": "./replaceStatusProject.sh && yarn prepareversion && eas update -p android --branch production --message "
    },
    "dependencies": {
        "@bam.tech/react-native-image-resizer": "^3.0.11",
        "@expo-google-fonts/comfortaa": "^0.2.3",
        "@react-native-async-storage/async-storage": "2.1.2",
        "@react-native-community/netinfo": "11.4.1",
        "@react-native-firebase/app": "^26.3.3",
        "@react-native-firebase/auth": "^26.3.3",
        "@react-native-firebase/firestore": "^26.3.3",
        "@react-native-firebase/functions": "^26.3.3",
        "@react-native-firebase/storage": "^26.3.3",
        "@react-navigation/bottom-tabs": "^7.16.2",
        "@react-navigation/drawer": "^7.10.3",
        "@react-navigation/native": "^7.2.5",
        "@react-navigation/native-stack": "^7.16.0",
        "@reduxjs/toolkit": "^1.9.5",
        "@sentry/react-native": "~6.14.0",
        "@shopify/flash-list": "1.7.6",
        "expo": "^53.0.0",
        "expo-application": "~6.1.5",
        "expo-asset": "~11.1.7",
        "expo-av": "~15.1.7",
        "expo-build-properties": "~0.14.8",
        "expo-camera": "~16.1.11",
        "expo-clipboard": "~7.1.5",
        "expo-constants": "~17.1.8",
        "expo-crypto": "~14.1.5",
        "expo-dev-client": "~5.2.4",
        "expo-document-picker": "~13.1.6",
        "expo-file-system": "~18.1.11",
        "expo-font": "~13.3.2",
        "expo-image-picker": "~16.1.4",
        "expo-linear-gradient": "~14.1.5",
        "expo-linking": "~7.1.7",
        "expo-location": "~18.1.6",
        "expo-navigation-bar": "~4.2.8",
        "expo-network": "~7.1.5",
        "expo-notifications": "~0.31.5",
        "expo-sharing": "^57.0.17",
        "expo-splash-screen": "~0.30.10",
        "expo-status-bar": "~2.2.3",
        "expo-system-ui": "~5.0.11",
        "expo-tracking-transparency": "~5.2.4",
        "expo-updates": "~0.28.18",
        "firebase": "10.14.1",
        "fuse.js": "^6.6.2",
        "lottie-react-native": "7.2.2",
        "polished": "^4.2.2",
        "react": "19.0.0",
        "react-addons-shallow-compare": "^15.6.3",
        "react-native": "0.79.6",
        "react-native-dotenv": "^3.4.9",
        "react-native-fs": "^2.20.0",
        "react-native-gesture-handler": "~2.24.0",
        "react-native-get-random-values": "~1.11.0",
        "react-native-gifted-charts": "^1.4.77",
        "react-native-masked-text": "^1.13.0",
        "react-native-pager-view": "6.7.1",
        "react-native-paper": "^5.15.3",
        "react-native-paper-dates": "^0.23.9",
        "react-native-paper-tabs": "^0.11.4",
        "react-native-reanimated": "~3.17.4",
        "react-native-responsive-fontsize": "^0.5.1",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "react-native-share": "^12.3.1",
        "react-native-svg": "15.11.2",
        "react-native-toast-message": "^2.3.3",
        "react-native-vector-icons": "^10.3.0",
        "react-native-view-shot": "4.0.3",
        "react-native-webview": "13.13.5",
        "react-redux": "^8.1.2",
        "redux": "^4.2.1",
        "styled-components": "^6.0.7",
        "xlsx": "^0.18.5",
        "yup": "^1.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@react-native-community/cli": "^15.0.0",
        "@react-native/metro-config": "^0.79.6",
        "eslint": "^7.32.0 || ^8.2.0",
        "eslint-config-airbnb": "latest",
        "eslint-config-airbnb-base": "latest",
        "eslint-plugin-import": "^2.25.3",
        "eslint-plugin-jsx-a11y": "^6.5.1",
        "eslint-plugin-react": "^7.28.0",
        "eslint-plugin-react-hooks": "^4.3.0",
        "jest": "29",
        "metro-cache-key": "^0.82.5",
        "prettier": "^3.0.1"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "expo-av",
                    "react-native-dotenv",
                    "react-native-fs",
                    "react-native-masked-text",
                    "react-native-responsive-fontsize"
                ],
                "listUnknownPackages": false
            }
        }
    },
    "private": true,
    "overrides": {}
}
